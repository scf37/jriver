#!/bin/sh
# list <dir> <prefix>: names of the files in <dir> starting with prefix, one per line (a missing dir is empty)
set -eu
[ $# = 2 ] || { echo "usage: list <dir> <prefix>" >&2; exit 2; }
[ -d "$1" ] || exit 0
out=$(ls -1 "$1")
printf '%s\n' "$out" | awk -v p="$2" 'length($0) > 0 && index($0, p) == 1'
