#!/bin/sh
# upload <dir> <file>: stdin -> <dir>/<file>, visible only when complete (not required of drivers)
set -eu
[ $# = 2 ] || { echo "usage: upload <dir> <file> (data on stdin)" >&2; exit 2; }
f="$1/$2"
mkdir -p "$(dirname "$f")"
tmp="$f.tmp.$$"
trap 'rm -f "$tmp"' EXIT
cat > "$tmp"
mv "$tmp" "$f"
