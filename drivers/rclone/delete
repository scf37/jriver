#!/bin/sh
# delete <remote:path> <file>: a missing file is fine; a folder left empty is removed
set -eu
[ $# = 2 ] || { echo "usage: delete <remote:path> <file>" >&2; exit 2; }
case "$2" in
  ""|"."|".."|/*|../*|*/..|*/../*|*//*) echo "refusing to delete '$2'" >&2; exit 2 ;;
esac
p="$1/$2"
if ! rclone deletefile "$p" 2>/dev/null; then
  # deletefile also fails if the file does not exist: fine, but not if it is still there
  if rclone lsf "$p" >/dev/null 2>&1; then echo "cannot delete $p" >&2; exit 1; fi
fi
case "$2" in */*) rclone rmdir "$1/${2%/*}" 2>/dev/null || true ;; esac
exit 0
