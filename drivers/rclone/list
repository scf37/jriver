#!/bin/sh
# list <remote:path> <prefix>: names of the files starting with prefix, one per line (needs rclone).
# A missing directory is an empty listing.
set -eu
[ $# = 2 ] || { echo "usage: list <remote:path> <prefix>" >&2; exit 2; }
rc=0
out=$(rclone lsf --files-only "$1") || rc=$?
if [ "$rc" != 0 ]; then
  # rclone exits with 3 if the directory is not found
  [ "$rc" = 3 ] && exit 0
  exit "$rc"
fi
printf '%s\n' "$out" | awk -v p="$2" 'length($0) > 0 && index($0, p) == 1'
