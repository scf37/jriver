#!/bin/sh
# delete <user@host:/dir> <file>: a missing file is fine
set -eu
[ $# = 2 ] || { echo "usage: delete <user@host:/dir> <file>" >&2; exit 2; }
case "$2" in
  ""|"."|".."|*/*) echo "refusing to delete '$2'" >&2; exit 2 ;;
esac
host=${1%%:*}; dir=${1#*:}
q() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }
# shellcheck disable=SC2086
exec ssh $SSH_OPTS "$host" "rm -f $(q "$dir/$2")"
