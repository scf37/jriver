#!/bin/sh
# list <user@host:/dir> <prefix>: the entries (files and folders) of one level starting with prefix, one per line, as
# name or folder/name. A prefix with a folder part ("f/arc") lists inside that folder. A missing dir is empty.
# ssh options via SSH_OPTS.
set -eu
[ $# = 2 ] || { echo "usage: list <user@host:/dir> <prefix>" >&2; exit 2; }
host=${1%%:*}; dir=${1#*:}
sub=${2%"${2##*/}"}
q() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }
# shellcheck disable=SC2086
out=$(ssh $SSH_OPTS "$host" "if [ -d $(q "$dir/$sub") ]; then ls -1 $(q "$dir/$sub"); fi")
printf '%s\n' "$out" | awk -v d="$sub" -v p="$2" 'length($0) > 0 { n = d $0; if (index(n, p) == 1) print n }'
